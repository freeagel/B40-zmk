// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#include <dt-bindings/zmk/pointing.h>

&soft_off {
    hold-time-ms = <2000>;
};

&msc {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        z_shift: z_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <1000>;
            retro-tap;
            bindings = <&kp>, <&kp>;
            display-name = "Z/Left Shift";
        };
    };

    combos {
        compatible = "zmk,combos";

        management_combo {
            timeout-ms = <100>;
            key-positions = <0 9>;
            bindings = <&mo 1>;
            layers = <0>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q     &kp W    &kp E    &kp R &kp T &kp Y     &kp U    &kp I     &kp O    &kp P
                &kp A     &kp S    &kp D    &kp F &kp G &kp H     &kp J    &kp K     &kp L    &kp BSPC
                &z_shift LSHIFT Z &kp X    &kp C    &kp V &kp B &kp N     &kp M    &kp COMMA &kp DOT  &kp RSHFT
                &kp LSHFT         &kp LCTL &kp LALT &mo 3 &mo 2 &kp SPACE &mo 4 &kp MINUS &kp APOS &kp ENTER
            >;
        };

        management_layer {
            display-name = "Management";
            bindings = <
                &trans       &trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &studio_unlock &trans &trans
                &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6          &kp F7 &kp F8 &kp F9 &kp F10
                &kp F11      &kp F12      &kp PG_UP    &kp PG_DN    &kp HOME     &kp END         &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &kp C_PP
                &kp C_PREV   &kp C_NEXT   &kp C_BRI_DN &kp C_BRI_UP &bt BT_CLR   &soft_off       &bt BT_CLR_ALL &sys_reset &kp K_UNDO &kp K_AGAIN
            >;
        };

        number_layer {
            display-name = "number";
            bindings = <
                &kp N1     &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7    &kp N8    &kp N9    &kp N0
                &kp TAB    &trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &kp BSLH  &kp DELETE
                &trans     &trans  &trans  &trans  &trans  &trans  &kp GRAVE &kp MINUS &kp EQUAL &kp FSLH
                &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &kp SEMI  &trans
            >;
        };

        number_shift_layer {
            display-name = "number_shift";
            bindings = <
                &kp EXCL   &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR
                &kp TAB    &trans &trans   &trans   &trans    &trans    &kp LBRC  &kp RBRC  &kp PIPE &kp DELETE
                &trans     &trans &trans   &trans   &trans    &trans    &kp TILDE &kp UNDER &kp PLUS &kp QUESTION
                &kp LSHFT  &trans &trans   &trans   &trans    &trans    &trans    &trans    &kp DQT  &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp ESC  &kp HOME &kp UP   &kp END   &trans        &trans           &mkp LCLK       &mmv MOVE_UP   &mkp RCLK       &kp LA(TAB)
                &kp TAB  &kp LEFT &kp DOWN &kp RIGHT &trans        &kp LG(H)         &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp DELETE
                &trans   &trans   &trans   &trans    &kp K_BACK    &kp K_FORWARD    &trans          &kp HOME       &kp UP          &kp END
                &kp LGUI &trans   &trans   &trans    &msc SCRL_UP   &msc SCRL_DOWN   &trans          &kp LEFT       &kp DOWN        &kp RIGHT
            >;
        };
    };
};
